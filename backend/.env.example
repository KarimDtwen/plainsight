# Copy to backend/.env for local development. Real values are NEVER committed;
# production values live in the Render dashboard (sync: false in render.yaml).

APP_ENV=development

# Supabase (M1+) — project URL + service-role key from the Supabase dashboard.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_KEY

# Dashboard admin login (single-user) and JWT signing secret.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_TTL_HOURS=168

# Comma-separated dashboard origins (production). Localhost is auto-allowed
# outside production.
ALLOWED_ORIGINS=
